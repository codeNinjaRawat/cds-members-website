{
  "name": "isgh-web",
  "version": "0.1.0",
  "private": true,
  "description": "ISGH Members \u2013 public website + member portal (Next.js). Content, settings, theme and feature flags come from the BE API (admin-controlled).",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "fast": "next build && next start",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "theme:build": "node scripts/build-theme.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "images": "node scripts/fetch-images.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
