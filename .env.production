# ---- ISGH website on the server (https://member-web.nextgrow.pro) – LIVE: talks to the API ----
# Used by `npm run build` and `npm run start` (rebuild after any change here). Values set in the shell win.
NEXT_PUBLIC_SITE_URL=https://member-web.nextgrow.pro
# The admin may show this site in its live-preview frame (theme editor) and push unsaved colors into it
ISGH_ADMIN_ORIGIN=https://member-admin.nextgrow.pro
NEXT_PUBLIC_ISGH_ADMIN_ORIGIN=https://member-admin.nextgrow.pro
# The API on the same server (BE, pm2 membership-api). Demo content instead: ISGH_USE_MOCK_API=true.
ISGH_USE_MOCK_API=false
ISGH_API_URL=http://127.0.0.1:4330
ISGH_API_TIMEOUT_MS=15000
# MS_EDGE_KEY = the API's EDGE_KEY – NOT here (this file is in git): put it in web/.env.production.local on the server.
# Still development data – keep it out of search engines
ISGH_NOINDEX=true
