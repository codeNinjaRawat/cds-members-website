# ---- ISGH website – PREVIEW server (https://member-web.nextgrow.pro) ----
# Used by `npm run build` and `npm run start`. Values already set in the shell win over this file.
NEXT_PUBLIC_SITE_URL=https://member-web.nextgrow.pro
# The admin may show this site in its live-preview frame (theme editor) and push unsaved colors into it
ISGH_ADMIN_ORIGIN=https://member-admin.nextgrow.pro
NEXT_PUBLIC_ISGH_ADMIN_ORIGIN=https://member-admin.nextgrow.pro
# No BE yet: demo content + whatever the admin publishes into the shared demo store folder
ISGH_USE_MOCK_API=true
ISGH_DEMO_STORE=../.demo-store
NEXT_PUBLIC_DEMO_SPEED=fast
# Demo content – keep it out of search engines
ISGH_NOINDEX=true
