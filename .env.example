# ---- ISGH web (copy to .env.local) ----
# Where the API lives (its internal address – the browser never calls it directly; /api/be/* passes calls on).
ISGH_API_URL=http://localhost:4330

# true = demo mode (built-in content + the admin's demo store, no API). false = live: every page and form uses the API.
ISGH_USE_MOCK_API=true

# Live mode: the same long secret as the API's EDGE_KEY – lets this website tell the API which address the visitor used.
MS_EDGE_KEY=

# Seconds the site caches BE responses (admin changes appear after this many seconds; BE can also trigger revalidation)
ISGH_CONFIG_REVALIDATE_SECONDS=60

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin demo (no BE yet) ----
# Folder the admin "Publish" button writes to; read here only while ISGH_USE_MOCK_API=true. "off" = ignore it.
ISGH_DEMO_STORE=../.demo-store
# Admin app origin allowed to show this site in its live-preview frame (empty = nobody may frame the site)
ISGH_ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_ISGH_ADMIN_ORIGIN=http://localhost:3001

# Demo forms speed (no API): fast = quick, like a good connection (default) · real = full delays to review loader steps · instant
NEXT_PUBLIC_DEMO_SPEED=fast
